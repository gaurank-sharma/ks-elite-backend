PORT=4000
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas (free M0 tier at mongodb.com/cloud/atlas) — required. Stores leads and posts.
MONGODB_URI=
MONGODB_DB=ks_elite

# Cloudinary — optional locally (falls back to server/data/uploads + server/data/files on
# disk), required in production since Vercel's filesystem is ephemeral. Free tier at
# cloudinary.com. In Cloudinary's dashboard, enable Settings > Security > "Allow delivery of
# PDF and ZIP files" or resume links will 401 — raw-file delivery is blocked by default.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin portal login (server/scripts/set-admin-password.js prints a hash for ADMIN_PASSWORD_HASH)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=

# Optional: leave SMTP_HOST unset to skip email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@kseliteattorneys.com
MAIL_TO=support@kseliteattorneys.com

# LLM provider (OpenAI-compatible) — powers the public chatbot and the admin AI content assistant.
# Defaults to Groq's free tier (console.groq.com — no card required). Swap LLM_BASE_URL/LLM_MODEL
# to point at a different OpenAI-compatible provider (xAI, OpenAI, etc.) without code changes.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Unsplash — powers "Suggest Images" for article hero images in the admin post editor.
# Free, no card required: unsplash.com/developers -> New Application -> Access Key.
UNSPLASH_ACCESS_KEY=
